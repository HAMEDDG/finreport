{% extends 'base.html.twig' %}

{% block title %}Connexion — Gestion des rapports financiers{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --ink-900: #0A1529;
            --ink-800: #0F1E3D;
            --paper: #FAFAF8;
            --text-muted: #C7CCDA;
            --gold: #C9A227;
            --gold-light: #E4C767;
            --danger: #FF8A80;
            --danger-bg: rgba(179, 38, 30, 0.18);
            --focus: #C9A227;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        body {
            position: relative;
            min-height: 100vh;
            background-image: url('{{ asset('images/login-bg.jpg') }}');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-repeat: no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(circle at 30% 20%, rgba(201, 162, 39, 0.10), transparent 55%),
                linear-gradient(160deg, rgba(10, 21, 41, 0.88) 0%, rgba(15, 30, 61, 0.78) 100%);
            pointer-events: none;
            z-index: 0;
        }

        .login-card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 400px;
            padding: 2.75rem 2.25rem 2.25rem;
            border-radius: 18px;
            background: rgba(15, 30, 61, 0.55);
            border: 1px solid rgba(255, 255, 255, 0.16);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.03) inset;
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            animation: riseIn 0.5s ease-out;
        }

        @keyframes riseIn {
            from { opacity: 0; transform: translateY(18px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .brand-mark {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.7rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--gold-light);
            margin: 0 0 1.1rem;
            text-align: center;
        }

        .form-heading {
            margin: 0 0 0.35rem;
            font-family: 'Source Serif 4', serif;
            font-weight: 500;
            font-size: 1.7rem;
            color: #fff;
            text-align: center;
        }

        .form-lead {
            margin: 0 0 1.9rem;
            color: var(--text-muted);
            font-size: 0.88rem;
            line-height: 1.5;
            text-align: center;
        }

        .field { margin-bottom: 1.05rem; }

        .field label {
            display: block;
            font-size: 0.78rem;
            font-weight: 500;
            margin-bottom: 0.4rem;
            color: var(--text-muted);
        }

        .input-shell {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-shell > svg {
            position: absolute;
            left: 0.85rem;
            width: 18px;
            height: 18px;
            color: rgba(255, 255, 255, 0.55);
            pointer-events: none;
        }

        .input-shell input {
            width: 100%;
            padding: 0.72rem 0.9rem 0.72rem 2.6rem;
            font-size: 0.95rem;
            font-family: inherit;
            color: #fff;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 9px;
            transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        }

        .input-shell input::placeholder { color: rgba(255, 255, 255, 0.4); }

        .input-shell input:focus-visible {
            outline: none;
            border-color: var(--focus);
            background: rgba(255, 255, 255, 0.12);
            box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.22);
        }

        .input-shell input[aria-invalid="true"] { border-color: var(--danger); }

        .toggle-password {
            position: absolute;
            right: 0.7rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            padding: 0.3rem;
            cursor: pointer;
            color: rgba(255, 255, 255, 0.55);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .toggle-password:hover { color: #fff; }

        .toggle-password:focus-visible {
            outline: 2px solid var(--gold);
            outline-offset: 2px;
            border-radius: 4px;
        }

        .toggle-password svg { width: 18px; height: 18px; }

        .submit-btn {
            width: 100%;
            padding: 0.78rem 1rem;
            margin-top: 0.6rem;
            font-family: inherit;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--ink-900);
            background: linear-gradient(135deg, var(--gold-light) 0%, var(--gold) 100%);
            border: none;
            border-radius: 9px;
            cursor: pointer;
            transition: filter 0.15s ease, transform 0.05s ease;
        }

        .submit-btn:hover { filter: brightness(1.06); }
        .submit-btn:active { transform: translateY(1px); }

        .submit-btn:focus-visible {
            outline: none;
            box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.4);
        }

        .alert {
            display: flex;
            gap: 0.55rem;
            align-items: flex-start;
            padding: 0.7rem 0.85rem;
            margin-bottom: 1.1rem;
            background: var(--danger-bg);
            border: 1px solid rgba(255, 138, 128, 0.35);
            border-radius: 8px;
            font-size: 0.82rem;
            color: #FFD9D5;
            line-height: 1.4;
        }

        .alert svg { flex-shrink: 0; margin-top: 2px; color: var(--danger); }

        .form-footer {
            margin-top: 1.6rem;
            padding-top: 1.15rem;
            border-top: 1px solid rgba(255, 255, 255, 0.14);
            font-size: 0.78rem;
            color: rgba(255, 255, 255, 0.55);
            line-height: 1.55;
            text-align: center;
        }

        .session-strip {
            margin-top: 1.4rem;
            display: flex;
            justify-content: space-between;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.68rem;
            color: rgba(255, 255, 255, 0.35);
            letter-spacing: 0.02em;
        }

        @media (max-width: 420px) {
            .login-card { padding: 2.25rem 1.5rem 1.75rem; border-radius: 14px; }
        }

        @media (prefers-reduced-motion: reduce) {
            * { animation: none !important; transition: none !important; }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="login-card">
        <p class="brand-mark">Gestion des rapports financiers</p>
        <h1 class="form-heading">Connexion</h1>
        <p class="form-lead">Accédez à votre espace de production de rapports</p>

        {% if error %}
            <div class="alert" role="alert" aria-live="assertive">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>Adresse e-mail ou mot de passe incorrect.</span>
            </div>
        {% endif %}

        <form method="post" novalidate>
            <div class="field">
                <label for="username">Adresse e-mail</label>
                <div class="input-shell">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Z"></path>
                        <path d="m22 6-10 7L2 6"></path>
                    </svg>
                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="_username"
                        id="username"
                        autocomplete="email"
                        placeholder="nom@entreprise.com"
                        aria-invalid="{{ error ? 'true' : 'false' }}"
                        required
                        autofocus
                    >
                </div>
            </div>

            <div class="field">
                <label for="password">Mot de passe</label>
                <div class="input-shell">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <input
                        type="password"
                        name="_password"
                        id="password"
                        autocomplete="current-password"
                        placeholder="••••••••"
                        aria-invalid="{{ error ? 'true' : 'false' }}"
                        required
                        style="padding-right: 2.8rem;"
                    >
                    <button type="button" class="toggle-password" id="togglePassword" aria-label="Afficher le mot de passe" aria-pressed="false" >
                        <svg id="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="submit-btn" type="submit">Se connecter</button>
        </form>

        <p class="form-footer">
            L'accès est attribué par un administrateur.<br>Aucune inscription en libre-service n'est proposée.
        </p>

        <div class="session-strip" aria-hidden="true" style="justify-content: flex-end;">
            <span id="ref-clock"></span>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var clockEl = document.getElementById('ref-clock');
            var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            function tick() {
                var now = new Date();
                var pad = function (n) { return String(n).padStart(2, '0'); };
                clockEl.textContent = pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
            }

            tick();
            if (!reduced) { setInterval(tick, 1000); }

            var toggleBtn = document.getElementById('togglePassword');
            var eyeIcon = document.getElementById('eyeIcon');
            var passwordInput = document.getElementById('password');
            var eyeOpenPath = '<path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"></path><circle cx="12" cy="12" r="3"></circle>';
            var eyeClosedPath = '<path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a20.3 20.3 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a20.5 20.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';

            toggleBtn.addEventListener('click', function () {
                
                var isVisible = passwordInput.type === 'text';
                passwordInput.type = isVisible ? 'password' : 'text';
                toggleBtn.setAttribute('aria-pressed', String(!isVisible));
                toggleBtn.setAttribute('aria-label', isVisible ? 'Afficher le mot de passe' : 'Masquer le mot de passe');
                eyeIcon.innerHTML = isVisible ? eyeOpenPath : eyeClosedPath;
            });
        });
    </script>
{% endblock %}