{% extends 'admin/index.html.twig' %}

{% block page_styles %}
    <style>
        .report-doc {
            background: #fff;
            border: 1px solid var(--paper-line);
            border-radius: 12px;
            padding: 2.5rem;
        }

        .report-doc-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding-bottom: 1.5rem;
            margin-bottom: 1.8rem;
            border-bottom: 2px solid var(--ink-800);
        }

        .report-doc-header .brand {
            font-family: 'Source Serif 4', serif;
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--ink-800);
        }

        .report-doc-header .brand img {
            max-height: 42px;
            max-width: 200px;
            display: block;
        }

        .report-doc-header .meta { text-align: right; font-size: 0.85rem; color: var(--text-muted); }
        .report-doc-header .meta strong { color: var(--text-primary); display: block; }

        .report-title-block { text-align: center; margin-bottom: 2rem; }
        .report-title-block h2 {
            font-family: 'Source Serif 4', serif;
            font-size: 1.4rem;
            margin: 0 0 0.2rem;
            color: var(--ink-800);
        }
        .report-title-block p { margin: 0.15rem 0; color: var(--text-muted); font-size: 0.9rem; }

        .section-title {
            font-family: 'Source Serif 4', serif;
            font-size: 1.15rem;
            color: var(--ink-800);
            margin: 2.2rem 0 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid var(--paper-line);
        }

        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .col-block h3 {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--gold-dark, #8A6E1B);
            margin: 0 0 0.8rem;
        }

        .line-item {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            border-bottom: 1px dashed var(--paper-line);
            font-size: 0.88rem;
        }

        .line-item.total {
            font-weight: 700;
            border-bottom: 2px solid var(--text-primary);
            border-top: 1px solid var(--text-primary);
            margin-top: 0.3rem;
        }

        .line-item .amount { font-variant-numeric: tabular-nums; }

        .resultat-table-wrap { max-width: 900px; margin: 0 auto 1rem; overflow-x: auto; }

        table.resultat-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.86rem;
            border: 1px solid var(--ink-800);
        }

        table.resultat-table th {
            text-align: left;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--gold-dark, #8A6E1B);
            padding: 0.5rem;
            background: var(--paper-line);
            border: 1px solid var(--ink-800);
        }

        table.resultat-table th.col-ref,
        table.resultat-table td.col-ref { width: 8%; }

        table.resultat-table th.col-sens,
        table.resultat-table td.col-sens { width: 6%; text-align: center; }

        table.resultat-table th.col-montant,
        table.resultat-table td.col-montant { width: 20%; text-align: right; }

        table.resultat-table td {
            padding: 0.5rem;
            border: 1px solid var(--paper-line);
            vertical-align: top;
        }

        table.resultat-table td.col-ref { text-align: center; color: var(--text-muted); }

        table.resultat-table td.col-montant { font-variant-numeric: tabular-nums; }

        table.resultat-table .note { color: var(--text-muted); font-weight: 600; margin-left: 0.3rem; }

        table.resultat-table tr.total td,
        table.resultat-table td.total-row {
            background: var(--paper-line);
            font-weight: 700;
            color: var(--ink-800);
            border-top: 1px solid var(--ink-800);
            border-bottom: 1px solid var(--ink-800);
        }

        table.resultat-table tr.total .titre,
        table.resultat-table .total-row .titre {
            text-transform: uppercase;
            letter-spacing: 0.02em;
        }

        table.resultat-table tr.total .formule,
        table.resultat-table .total-row .formule {
            display: block;
            font-weight: 400;
            font-size: 0.74rem;
            color: var(--text-muted);
            margin-top: 0.15rem;
            text-transform: none;
        }

        .bilan-wrap { max-width: 100%; }
        table.bilan-table { font-size: 0.76rem; }
        table.bilan-table th, table.bilan-table td { padding: 0.4rem; }
        table.bilan-table th[colspan] { text-align: center; }
        table.bilan-table td:nth-child(6),
        table.bilan-table th:nth-child(6) { border-left: 2px solid var(--ink-800); }

        .report-actions {
            display: flex;
            justify-content: flex-end;
            gap: 0.8rem;
            margin-top: 2rem;
        }

        .btn-outline {
            background: #fff;
            border: 1px solid var(--paper-line);
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.88rem;
            cursor: pointer;
            text-decoration: none;
            color: var(--text-primary);
        }

        .btn-primary {
            background: var(--ink-800);
            color: #fff;
            border: none;
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.88rem;
            cursor: pointer;
        }

        @media (max-width: 760px) {
            .two-col { grid-template-columns: 1fr; }
        }
    </style>
{% endblock %}

{% block content %}
    <div class="page-header">
        <h1>Rapport financier — {{ report.entreprise }}</h1>
        <p>Exercice {{ report.exercice }}</p>
    </div>

    <div class="report-doc">
        <div class="report-doc-header">
            <div class="brand">
                {% if settings.logoEntreprise %}
                    <img src="{{ asset('uploads/logos/' ~ settings.logoEntreprise) }}" alt="Logo">
                {% else %}
                    ◆ FinReport
                {% endif %}
            </div>
            <div class="meta">
                <strong>{{ report.entreprise }}</strong>
                Exercice {{ report.exercice }}<br>
                Généré le {{ report.dateGeneration|date('d/m/Y à H:i') }}
            </div>
        </div>

        <div class="report-title-block">
            <h2>ETATS FINANCIERS PROVISOIRES</h2>
            <p>AU {{ report.balance ? report.balance.dateFin|date('d/m/Y') : '31/12/' ~ report.exercice }}</p>
            <p>(EN {{ settings.devise }})</p>
        </div>

        <div class="section-title">BILAN</div>
        <div class="resultat-table-wrap bilan-wrap">
            <table class="resultat-table bilan-table">
                <thead>
                    <tr>
                        <th colspan="5">Actif</th>
                        <th colspan="3">Passif</th>
                    </tr>
                    <tr>
                        <th class="col-ref">Réf</th>
                        <th>Libellés</th>
                        <th class="col-montant">Brut</th>
                        <th class="col-montant">Amort/Prov</th>
                        <th class="col-montant">Net {{ report.exercice }}</th>
                        <th class="col-ref">Réf</th>
                        <th>Libellés</th>
                        <th class="col-montant">Net {{ report.exercice }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% set nbLignes = report.bilanActif|length > report.bilanPassif|length ? report.bilanActif|length : report.bilanPassif|length %}
                    {% for i in 0..(nbLignes - 1) %}
                        {% set a = report.bilanActif[i]|default(null) %}
                        {% set p = report.bilanPassif[i]|default(null) %}
                        <tr>
                            <td class="col-ref{{ a and a.type == 'total' ? ' total-row' }}">{{ a ? a.ref|default('') }}</td>
                            {% if a and a.type == 'total' %}
                                {% set parties = a.libelle|split(' (', 2) %}
                                <td class="total-row">
                                    <span class="titre">{{ parties[0] }}</span>
                                    {% if parties[1] is defined %}<span class="formule">({{ parties[1] }}</span>{% endif %}
                                </td>
                                <td class="col-montant total-row">{{ a.brut|number_format(0, ',', ' ') }}</td>
                                <td class="col-montant total-row">{{ a.amortProv|number_format(0, ',', ' ') }}</td>
                                <td class="col-montant total-row">{{ a.montant|number_format(0, ',', ' ') }}</td>
                            {% else %}
                                <td>{{ a ? a.libelle }}</td>
                                <td class="col-montant">{{ a ? a.brut|number_format(0, ',', ' ') }}</td>
                                <td class="col-montant">{{ a ? a.amortProv|number_format(0, ',', ' ') }}</td>
                                <td class="col-montant">{{ a ? a.montant|number_format(0, ',', ' ') }}</td>
                            {% endif %}
                            <td class="col-ref{{ p and p.type == 'total' ? ' total-row' }}">{{ p ? p.ref|default('') }}</td>
                            {% if p and p.type == 'total' %}
                                {% set partiesP = p.libelle|split(' (', 2) %}
                                <td class="total-row">
                                    <span class="titre">{{ partiesP[0] }}</span>
                                    {% if partiesP[1] is defined %}<span class="formule">({{ partiesP[1] }}</span>{% endif %}
                                </td>
                                <td class="col-montant total-row">{{ p.montant|number_format(0, ',', ' ') }}</td>
                            {% else %}
                                <td>{{ p ? p.libelle }}</td>
                                <td class="col-montant">{{ p ? p.montant|number_format(0, ',', ' ') }}</td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="section-title">COMPTE DE RÉSULTAT</div>
        <div class="resultat-table-wrap">
            <table class="resultat-table">
                <thead>
                    <tr>
                        <th class="col-ref">Réf</th>
                        <th>Libellés</th>
                        <th class="col-sens">(2)</th>
                        <th class="col-montant">Exercice {{ report.exercice }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ligne in report.compteResultat %}
                        <tr{{ ligne.type == 'total' ? ' class="total"' }}>
                            <td class="col-ref">{{ ligne.ref|default('') }}</td>
                            {% if ligne.type == 'total' %}
                                {% set parties = ligne.libelle|split(' (', 2) %}
                                <td>
                                    <span class="titre">{{ parties[0] }}</span>
                                    {% if parties[1] is defined %}<span class="formule">({{ parties[1] }}</span>{% endif %}
                                </td>
                            {% else %}
                                <td>{{ ligne.libelle }}{% if ligne.note %}<span class="note">({{ ligne.note }})</span>{% endif %}</td>
                            {% endif %}
                            <td class="col-sens">{{ ligne.sens|default('') }}</td>
                            <td class="col-montant">{{ ligne.montant|number_format(0, ',', ' ') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="report-actions">
            <a href="{{ path('app_admin_reports') }}" class="btn-outline">← Retour aux rapports</a>
            <a href="{{ path('app_admin_report_pdf', {id: report.id}) }}" class="btn-primary" style="text-decoration: none; display: inline-block;">Télécharger PDF</a>
        </div>
    </div>
{% endblock %}
