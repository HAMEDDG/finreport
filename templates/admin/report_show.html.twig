{% extends 'admin/index.html.twig' %}

{% block page_styles %}
    <style>
        .report-doc {
            background: #fff;
            border: 1px solid var(--paper-line);
            border-radius: 12px;
            padding: 2.5rem;
        }

        .report-doc-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding-bottom: 1.5rem;
            margin-bottom: 1.8rem;
            border-bottom: 2px solid var(--ink-800);
        }

        .report-doc-header .brand {
            font-family: 'Source Serif 4', serif;
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--ink-800);
        }

        .report-doc-header .brand img {
            max-height: 42px;
            max-width: 200px;
            display: block;
        }

        .report-doc-header .meta { text-align: right; font-size: 0.85rem; color: var(--text-muted); }
        .report-doc-header .meta strong { color: var(--text-primary); display: block; }

        .report-title-block { text-align: center; margin-bottom: 2rem; }
        .report-title-block h2 {
            font-family: 'Source Serif 4', serif;
            font-size: 1.4rem;
            margin: 0 0 0.2rem;
            color: var(--ink-800);
        }
        .report-title-block p { margin: 0.15rem 0; color: var(--text-muted); font-size: 0.9rem; }

        .section-title {
            font-family: 'Source Serif 4', serif;
            font-size: 1.15rem;
            color: var(--ink-800);
            margin: 2.2rem 0 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid var(--paper-line);
        }

        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .col-block h3 {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--gold-dark, #8A6E1B);
            margin: 0 0 0.8rem;
        }

        .line-item {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            border-bottom: 1px dashed var(--paper-line);
            font-size: 0.88rem;
        }

        .line-item.total {
            font-weight: 700;
            border-bottom: 2px solid var(--text-primary);
            border-top: 1px solid var(--text-primary);
            margin-top: 0.3rem;
        }

        .line-item .amount { font-variant-numeric: tabular-nums; }

        .report-actions {
            display: flex;
            justify-content: flex-end;
            gap: 0.8rem;
            margin-top: 2rem;
        }

        .btn-outline {
            background: #fff;
            border: 1px solid var(--paper-line);
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.88rem;
            cursor: pointer;
            text-decoration: none;
            color: var(--text-primary);
        }

        .btn-primary {
            background: var(--ink-800);
            color: #fff;
            border: none;
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.88rem;
            cursor: pointer;
        }

        @media (max-width: 760px) {
            .two-col { grid-template-columns: 1fr; }
        }
    </style>
{% endblock %}

{% block content %}
    <div class="page-header">
        <h1>Rapport financier — {{ report.entreprise }}</h1>
        <p>Exercice {{ report.exercice }}</p>
    </div>

    <div class="report-doc">
        <div class="report-doc-header">
            <div class="brand">
                {% if settings.logoEntreprise %}
                    <img src="{{ asset('uploads/logos/' ~ settings.logoEntreprise) }}" alt="Logo">
                {% else %}
                    ◆ FinReport
                {% endif %}
            </div>
            <div class="meta">
                <strong>{{ report.entreprise }}</strong>
                Exercice {{ report.exercice }}<br>
                Généré le {{ report.dateGeneration|date('d/m/Y à H:i') }}
            </div>
        </div>

        <div class="report-title-block">
            <h2>ETATS FINANCIERS PROVISOIRES</h2>
            <p>AU 31/12/{{ report.exercice }}</p>
            <p>(EN {{ settings.devise }})</p>
        </div>

        <div class="section-title">BILAN</div>
        <div class="two-col">
            <div class="col-block">
                <h3>Actif</h3>
                {% for libelle, montant in report.bilanActif %}
                    <div class="line-item {{ libelle starts with 'Total' ? 'total' }}">
                        <span>{{ libelle }}</span>
                        <span class="amount">{{ montant|number_format(0, ',', ' ') }}</span>
                    </div>
                {% endfor %}
            </div>
            <div class="col-block">
                <h3>Passif</h3>
                {% for libelle, montant in report.bilanPassif %}
                    <div class="line-item {{ libelle starts with 'Total' ? 'total' }}">
                        <span>{{ libelle }}</span>
                        <span class="amount">{{ montant|number_format(0, ',', ' ') }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="section-title">COMPTE DE RÉSULTAT</div>
        <div class="two-col">
            <div class="col-block">
                <h3>Charges</h3>
                {% for libelle, montant in report.compteCharges %}
                    <div class="line-item {{ libelle starts with 'Total' ? 'total' }}">
                        <span>{{ libelle }}</span>
                        <span class="amount">{{ montant|number_format(0, ',', ' ') }}</span>
                    </div>
                {% endfor %}
            </div>
            <div class="col-block">
                <h3>Produits</h3>
                {% for libelle, montant in report.compteProduits %}
                    <div class="line-item {{ libelle starts with 'Total' ? 'total' }}">
                        <span>{{ libelle }}</span>
                        <span class="amount">{{ montant|number_format(0, ',', ' ') }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="report-actions">
            <a href="{{ path('app_admin_reports') }}" class="btn-outline">← Retour aux rapports</a>
            <a href="{{ path('app_admin_report_pdf', {id: report.id}) }}" class="btn-primary" style="text-decoration: none; display: inline-block;">Télécharger PDF</a>
        </div>
    </div>
{% endblock %}
