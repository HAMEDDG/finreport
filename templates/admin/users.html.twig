{% extends 'admin/index.html.twig' %}

{% block page_styles %}
    <style>
        .toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem; gap: 1rem; }
        .search-input { padding: 0.55rem 0.8rem; border: 1px solid var(--paper-line); border-radius: 8px; font-family: inherit; font-size: 0.88rem; width: 260px; }
        .search-input:focus { outline: none; border-color: var(--gold); }

        .btn-primary {
            background: var(--ink-800); color: #fff; border: none; padding: 0.6rem 1.2rem;
            border-radius: 8px; font-family: inherit; font-size: 0.88rem; cursor: pointer;
        }

        .data-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
        .data-table th { text-align: left; padding: 0.7rem 0.9rem; color: var(--text-muted); font-weight: 600; font-size: 0.76rem; text-transform: uppercase; border-bottom: 1px solid var(--paper-line); }
        .data-table td { padding: 0.75rem 0.9rem; border-bottom: 1px solid var(--paper-line); }

        .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.74rem; font-weight: 600; }
        .badge-admin { background: rgba(201,162,39,0.16); color: #8A6E1B; }
        .badge-user { background: #E8ECF3; color: #3D5A9E; }

        .icon-btn { background: none; border: 1px solid var(--paper-line); border-radius: 6px; padding: 0.35rem 0.55rem; cursor: pointer; font-size: 0.85rem; }
        .icon-btn:hover { background: var(--paper); }
        .icon-btn.danger { color: #B3261E; }
        .table-actions { display: flex; gap: 0.5rem; }

        .modal-overlay {
            display: none;
            position: fixed; inset: 0; background: rgba(10,21,41,0.5);
            z-index: 300; align-items: center; justify-content: center;
        }
        .modal-overlay.open { display: flex; }

        .modal-box {
            background: #fff; border-radius: 12px; padding: 1.8rem; width: 100%; max-width: 420px;
        }

        .modal-box h3 { font-family: 'Source Serif 4', serif; font-weight: 500; margin: 0 0 1.2rem; }

        .form-field { margin-bottom: 1rem; }

        .form-field label {
            display: block;
            font-size: 0.82rem;
            font-weight: 500;
            margin-bottom: 0.35rem;
            color: var(--text-primary);
        }

        .form-field select,
        .form-field input {
            width: 100%;
            padding: 0.6rem 0.75rem;
            border: 1px solid var(--paper-line);
            border-radius: 7px;
            font-family: inherit;
            font-size: 0.9rem;
        }

        .form-field select:focus,
        .form-field input:focus {
            outline: none;
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.15);
        }

        .form-errors { color: #B3261E; font-size: 0.78rem; margin-top: 0.3rem; }

        /* form_errors() de Symfony rend une simple <ul><li> sans classe : on la cible
           directement pour que les erreurs de validation soient visibles. */
        .modal-box ul { color: #B3261E; font-size: 0.82rem; margin: 0.3rem 0 0.7rem; padding-left: 1.2rem; }
        .modal-box ul li { margin-bottom: 0.15rem; }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 0.6rem;
            margin-top: 1.4rem;
        }

        .btn-outline {
            background: #fff;
            border: 1px solid var(--paper-line);
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.88rem;
            cursor: pointer;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="page-header">
        <h1>Gestion des utilisateurs</h1>
        <p>Créer, modifier et gérer les comptes</p>
    </div>

    <div class="content-card" style="display: block; padding: 1.5rem;">
        <div class="toolbar">
            <input type="text" class="search-input" id="searchInput" placeholder="Rechercher un utilisateur...">
            <button type="button" class="btn-primary" id="newUserBtn">+ Nouvel utilisateur</button>
        </div>

        {% if users is empty %}
            <p class="placeholder-text">Aucun utilisateur pour le moment.</p>
        {% else %}
            <table class="data-table" id="usersTable">
                <thead>
                    <tr>
                        <th>Adresse e-mail</th>
                        <th>Rôle</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.email }}</td>
                            <td>
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <span class="badge badge-admin">Administrateur</span>
                                {% else %}
                                    <span class="badge badge-user">Utilisateur</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="table-actions">
                                    <button class="icon-btn edit-user-btn" type="button" title="Modifier"
                                        data-id="{{ user.id }}"
                                        data-email="{{ user.email }}"
                                        data-role="{{ 'ROLE_ADMIN' in user.roles ? 'ROLE_ADMIN' : 'ROLE_USER' }}">
                                        ✏
                                    </button>

                                    <form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer cet utilisateur ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                                        <button class="icon-btn danger" type="submit" title="Supprimer" {{ user == app.user ? 'disabled' }}>🗑</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    <div class="toast-stack" id="toastStack" style="position: fixed; top: 80px; right: 20px; z-index: 200; display: flex; flex-direction: column; gap: 0.6rem;">
        {% for message in app.flashes('success') %}
            <div class="toast" style="background: var(--ink-800); color: #fff; padding: 0.8rem 1.1rem; border-radius: 8px; font-size: 0.85rem; box-shadow: 0 10px 25px rgba(0,0,0,0.18); border-left: 3px solid var(--gold);">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="toast" style="background: var(--ink-800); color: #fff; padding: 0.8rem 1.1rem; border-radius: 8px; font-size: 0.85rem; box-shadow: 0 10px 25px rgba(0,0,0,0.18); border-left: 3px solid #E06A63;">{{ message }}</div>
        {% endfor %}
    </div>

    <div class="modal-overlay" id="newUserModal">
        <div class="modal-box">
            <h3>Nouvel utilisateur</h3>
            {{ form_start(form, {'action': path('app_admin_user_new'), 'method': 'post'}) }}
                <div class="form-field">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>
                <div class="form-field">
                    {{ form_label(form.roleChoisi) }}
                    {{ form_widget(form.roleChoisi) }}
                    {{ form_errors(form.roleChoisi) }}
                </div>
                <div class="form-field">
                    {{ form_label(form.plainPassword) }}
                    {{ form_widget(form.plainPassword) }}
                    {{ form_errors(form.plainPassword) }}
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-outline" data-close-modal>Annuler</button>
                    <button type="submit" class="btn-primary">Créer</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    <div class="modal-overlay" id="editUserModal">
        <div class="modal-box">
            <h3>Modifier l'utilisateur</h3>
            <form method="post" id="editUserForm">
                <input type="hidden" name="user[_token]" value="{{ csrf_token('user') }}">
                <div class="form-field">
                    <label for="edit-email">Adresse e-mail</label>
                    <input type="email" name="user[email]" id="edit-email" required>
                </div>
                <div class="form-field">
                    <label for="edit-role">Rôle</label>
                    <select name="user[roleChoisi]" id="edit-role">
                        <option value="ROLE_USER">Utilisateur</option>
                        <option value="ROLE_ADMIN">Administrateur</option>
                    </select>
                </div>
                <div class="form-field">
                    <label for="edit-password">Nouveau mot de passe (laisser vide pour ne pas changer)</label>
                    <input type="password" name="user[plainPassword]" id="edit-password">
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-outline" data-close-modal>Annuler</button>
                    <button type="submit" class="btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block page_scripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var searchInput = document.getElementById('searchInput');
            var table = document.getElementById('usersTable');

            if (searchInput && table) {
                searchInput.addEventListener('input', function () {
                    var term = searchInput.value.toLowerCase();
                    table.querySelectorAll('tbody tr').forEach(function (row) {
                        row.style.display = row.textContent.toLowerCase().includes(term) ? '' : 'none';
                    });
                });
            }

            var newUserBtn = document.getElementById('newUserBtn');
            var newUserModal = document.getElementById('newUserModal');
            var editUserModal = document.getElementById('editUserModal');
            var editUserForm = document.getElementById('editUserForm');

            if (newUserBtn) {
                newUserBtn.addEventListener('click', function () { newUserModal.classList.add('open'); });
            }

            document.querySelectorAll('.edit-user-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = btn.dataset.id;
                    editUserForm.action = '{{ path('app_admin_user_edit', {id: '__ID__'}) }}'.replace('__ID__', id);
                    document.getElementById('edit-email').value = btn.dataset.email;
                    document.getElementById('edit-role').value = btn.dataset.role;
                    document.getElementById('edit-password').value = '';
                    editUserModal.classList.add('open');
                });
            });

            document.querySelectorAll('[data-close-modal]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    newUserModal.classList.remove('open');
                    editUserModal.classList.remove('open');
                });
            });

            [newUserModal, editUserModal].forEach(function (overlay) {
                overlay.addEventListener('click', function (e) {
                    if (e.target === overlay) { overlay.classList.remove('open'); }
                });
            });

            setTimeout(function () {
                document.querySelectorAll('#toastStack .toast').forEach(function (t) {
                    t.style.transition = 'opacity 0.4s ease';
                    t.style.opacity = '0';
                    setTimeout(function () { t.remove(); }, 400);
                });
            }, 4000);
        });
    </script>
{% endblock %}
